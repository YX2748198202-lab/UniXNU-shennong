--- a/drivers/ShengUfs/NativeUfs.cpp
+++ b/drivers/ShengUfs/NativeUfs.cpp
@@ -1950,6 +1950,12 @@
 static char gPendingUuid[4][37];
 static UfsRootPlan gPublicationPlan;
 static NativeUfs *gPendingProvider;
+// 0 while the publisher runs, 1 when every window is published and its media are
+// ready, 2 when it gave up. startRoot waits for a final value, so a boot never
+// starts the mount against half-published windows and a failure is never reported
+// as success.
+static volatile int gRootPublicationResult;
+static volatile unsigned gRootWindowsReady;
 
 static bool mediaWithUuidExists (const char *uuid, NativeUfsBlock *window)
 {
@@ -2041,6 +2047,7 @@
       }
       IOLog ("NativeUfs: %s volume %s %s\n", device->windowLabel (), uuid, ready ? "ready" : "not ready");
       if (!ready) captureMissingMedia (uuid);
+      else gRootWindowsReady = gRootWindowsReady + 1;
       return ready;
     }
     void discard (unsigned index) { discardPendingWindow (index); }
@@ -2055,6 +2062,9 @@
     // Start failures have already released their unpublished object; do not
     // dereference it here. The media-failure object is deliberately retained.
     rootDiagnosticFailure (reason);
+    gRootPublicationResult = 2;
+  } else {
+    gRootPublicationResult = 1;
   }
   gPendingProvider->release ();  // Balanced with successful thread dispatch.
 }
@@ -2300,6 +2310,8 @@
   // Prepare all windows or publish none. Diagnostics never decide policy.
   gPending = 0;
   gPendingProvider = this;
+  gRootPublicationResult = 0;
+  gRootWindowsReady = 0;
   struct Operations {
     NativeUfs *owner;
     RootLayout *layout;
@@ -2347,6 +2359,19 @@
         return false;
       }
       thread_deallocate (thread);
+      // Publication used to be fire-and-forget: a boot could reach IOFindBSDRoot before
+      // the windows existed, and the same image mounted on one run and panicked with
+      // "Failed to mount root device" on the next. Wait for a final result so the media
+      // are in place, and report failure as failure instead of reporting the thread.
+      unsigned waited = 0;
+      while (gRootPublicationResult == 0 && waited < 300) {
+        IOSleep (100);
+        ++waited;
+      }
+      IOLog ("NativeUfs: root publication %s after %u00 ms; windows ready=%u published=%u\n",
+             gRootPublicationResult == 1 ? "complete" :
+             (gRootPublicationResult == 2 ? "failed" : "timed out"),
+             waited, gRootWindowsReady, native_ufs_blocks_published);
       return true;
     }
     void discard (unsigned index) { discardPendingWindow (index); }
