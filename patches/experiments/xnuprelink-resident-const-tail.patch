+class ResidentConstantTests(unittest.TestCase):
+    def layout(self, native_size=PAGE * 4, *, maxprot=1, initprot=1, alias_size=PAGE * 6):
+        base = 0x100000000
+        text = dict(name='__PRELINK_TEXT', va=base + PAGE, size=PAGE * 6,
+                    fileoff=PAGE, filesize=PAGE * 6, command_offset=0)
+        const = dict(name='__DATA_CONST', va=base + PAGE * 7, size=PAGE * 10,
+                     fileoff=PAGE * 7, filesize=PAGE * 10, command_offset=152)
+        raw = bytearray(PAGE * 17)
+        struct.pack_into('<III', raw, 56, 1, 1, 1)
+        struct.pack_into('<16s16sQQ4I', raw, 72, b'__text', b'__PRELINK_TEXT',
+                         text['va'], alias_size, PAGE, 0, 0, 0)
+        struct.pack_into('<III', raw, 208, maxprot, initprot, 0)
+        layout = Layout.__new__(Layout)
+        layout.cache = SimpleNamespace(base=base, data=raw)
+        layout.roots = {x['name']: x for x in (text, const)}
+        layout.native = SimpleNamespace(segments=[dict(name='__TEXT', size=PAGE),
+                                                  dict(name='__DATA_CONST', size=native_size),
+                                                  dict(name='__LASTDATA_CONST', size=PAGE)])
+        layout.placements = {'__TEXT': base + PAGE * 2}
+        layout.occupied = [(base + PAGE * 3, base + PAGE * 5),
+                           (base + PAGE * 10, base + PAGE * 12)]
+        layout.retained_file = [(PAGE * 3, PAGE * 5), (PAGE * 10, PAGE * 12)]
+        return layout, base
+
+    def test_no_borrow_when_already_fits(self):
+        layout, base = self.layout(PAGE * 2)
+        layout.place_constants()
+        self.assertIsNone(layout.const_tail)
+        self.assertEqual(layout.placements['__DATA_CONST'], base + PAGE * 7)
+
+    def test_borrow_minimum_whole_pages_preserving_va_file_mapping(self):
+        layout, base = self.layout()
+        layout.place_constants()
+        self.assertEqual(layout.const_tail, (base + PAGE * 5, base + PAGE * 7))
+        text, const = (layout.roots[s] for s in ('__PRELINK_TEXT', '__DATA_CONST'))
+        self.assertEqual(text['va'] + text['size'], const['va'])
+        self.assertEqual(text['fileoff'] + text['filesize'], const['fileoff'])
+        self.assertEqual(const['va'] - base, const['fileoff'])
+        self.assertEqual(const['va'] + const['size'], base + PAGE * 17)
+        self.assertEqual(layout.end('__LASTDATA_CONST'), base + PAGE * 10)
+
+    def test_insufficient_or_physically_occupied_tail_rejected(self):
+        layout, _ = self.layout(PAGE * 5)
+        with self.assertRaisesRegex(ValueError, 'Insufficient unused __PRELINK_TEXT'):
+            layout.place_constants()
+        layout, _ = self.layout()
+        layout.retained_file.append((PAGE * 5, PAGE * 5 + 32))
+        with self.assertRaisesRegex(ValueError, 'Insufficient unused __PRELINK_TEXT'):
+            layout.place_constants()
+        layout, base = self.layout()
+        layout.placements['__TEXT'] = base + PAGE * 5
+        with self.assertRaisesRegex(ValueError, 'Insufficient unused __PRELINK_TEXT'):
+            layout.place_constants()
+
+    def test_executable_non_linear_or_named_section_rejected(self):
+        for settings, message in (({'maxprot': 5}, 'non-linear or executable'),
+                                  ({'initprot': 5}, 'non-linear or executable'),
+                                  ({'alias_size': PAGE}, 'root section geometry')):
+            layout, _ = self.layout(**settings)
+            with self.assertRaisesRegex(ValueError, message):
+                layout.place_constants()
+        layout, _ = self.layout()
+        layout.roots['__DATA_CONST']['fileoff'] += PAGE
+        with self.assertRaisesRegex(ValueError, 'non-linear or executable'):
+            layout.place_constants()
+
+    def test_retained_target_cannot_address_borrowed_page(self):
+        emit = SegmentedEmit.__new__(SegmentedEmit)
+        emit.layout, _ = self.layout()
+        emit.layout.place_constants()
+        lo, hi = emit.layout.const_tail
+        for target in (lo - 1, hi):
+            emit.check_const_tail_reference(target, 0x1c0)
+        for target in (lo, hi - 1):
+            with self.assertRaisesRegex(ValueError, 'repurposed text tail'):
+                emit.check_const_tail_reference(target, 0x1c0)
+
+
