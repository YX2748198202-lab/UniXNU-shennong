+    def place_constants(self):
+        """Borrow only a disjoint file-backed suffix of the donor's text container."""
+        self.const_tail = None
+        const = self.roots['__DATA_CONST']
+        boundary = const['va']
+        limit = boundary + const['size']
+        first_retained = min([limit] + [max(begin, boundary) for begin, end in self.occupied
+                                         if boundary < end and begin < limit])
+        needed = (align(boundary + self.segment('__DATA_CONST')['size']) +
+                  self.segment('__LASTDATA_CONST')['size'])
+        if needed > first_retained:
+            text = self.roots['__PRELINK_TEXT']
+            shift = align(needed - first_retained)
+            start = boundary - shift
+            file_start, file_end = start - self.cache.base, boundary - self.cache.base
+            if (boundary % PAGE or text['va'] % PAGE or text['va'] + text['size'] != boundary
+                    or start <= text['va'] or start < self.end('__TEXT')
+                    or any(start < end and begin < boundary for begin, end in self.occupied)
+                    or any(file_start < end and begin < file_end for begin, end in self.retained_file)):
+                raise ValueError('Insufficient unused __PRELINK_TEXT tail for native constants')
+            for seg in (text, const):
+                maxprot, initprot = struct.unpack_from('<II', self.cache.data, seg['command_offset'] + 56)
+                if (seg['fileoff'] != seg['va'] - self.cache.base or seg['filesize'] != seg['size']
+                        or seg['fileoff'] + seg['filesize'] > len(self.cache.data)
+                        or (maxprot | initprot) & 4 or not initprot & 1):
+                    raise ValueError('Cannot repartition non-linear or executable constant containers')
+            # The only supported root section is the aggregate __text alias
+            # of __PRELINK_TEXT itself. Never truncate a named live section.
+            text_cmd, const_cmd = text['command_offset'], const['command_offset']
+            text_n, = struct.unpack_from('<I', self.cache.data, text_cmd + 64)
+            const_n, = struct.unpack_from('<I', self.cache.data, const_cmd + 64)
+            if text_n != 1 or const_n:
+                raise ValueError('Unexpected root sections in constant containers')
+            name, segname, va, size, offset, _, reloff, nreloc = struct.unpack_from(
+                '<16s16sQQ4I', self.cache.data, text_cmd + 72)
+            if ((name.rstrip(b'\0'), segname.rstrip(b'\0'), va, size, offset) !=
+                    (b'__text', b'__PRELINK_TEXT', text['va'], text['size'], text['fileoff'])
+                    or reloff or nreloc):
+                raise ValueError('Unsupported __PRELINK_TEXT root section geometry')
+            text['size'] -= shift
+            text['filesize'] -= shift
+            const.update(va=start, fileoff=file_start, size=const['size'] + shift,
+                         filesize=const['filesize'] + shift)
+            self.const_tail = (start, boundary)
+        self.reserve('__DATA_CONST', const['va'])
+        self.reserve('__LASTDATA_CONST', align(self.end('__DATA_CONST')))
+
     def segment(self, name):
         return next(s for s in self.native.segments if s['name'] == name)

