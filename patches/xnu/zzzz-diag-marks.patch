diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index 630a37a..42c62d1 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -657,13 +657,19 @@ kernel_bootstrap_thread(void)
 	/*
 	 *	Create the device service.
 	 */
+	boot_progress_stage("device_service_create enter");
 	device_service_create();
+	boot_progress_stage("device_service_create returned");
 
+	boot_progress_stage("phys_carveout_init enter");
 	phys_carveout_init();
+	boot_progress_stage("phys_carveout_init returned");
 
 #if MACH_KDP
 	kernel_bootstrap_log("kdp_init");
+	boot_progress_stage("kdp_init enter");
 	kdp_init();
+	boot_progress_stage("kdp_init returned");
 #endif
 
 #if ALTERNATE_DEBUGGER
@@ -689,15 +695,18 @@ kernel_bootstrap_thread(void)
 	 * Force the random number to be odd to avoid mapping a non-zero
 	 * word-aligned address to zero via addition.
 	 */
+	boot_progress_stage("early_random enter");
 	vm_kernel_addrperm = (vm_offset_t)(early_random() | 1);
 	buf_kernel_addrperm = (vm_offset_t)(early_random() | 1);
 	vm_kernel_addrperm_ext = (vm_offset_t)(early_random() | 1);
 	vm_kernel_addrhash_salt = early_random();
 	vm_kernel_addrhash_salt_ext = early_random();
+	boot_progress_stage("early_random returned");
 
 #ifdef  IOKIT
 	kernel_bootstrap_log("PE_init_iokit");
 	PE_init_iokit();
+	boot_progress_stage("PE_init_iokit returned");
 #endif
 
 	assert(ml_get_interrupts_enabled() == FALSE);
diff --git a/osfmk/prng/prng_random.c b/osfmk/prng/prng_random.c
index c52f0ab..dffaa20 100644
--- a/osfmk/prng/prng_random.c
+++ b/osfmk/prng/prng_random.c
@@ -26,6 +26,7 @@
  * @APPLE_OSREFERENCE_LICENSE_HEADER_END@
  */
 
+#include <kern/boot_progress.h>
 #include <kern/locks.h>
 #include <kern/cpu_number.h>
 #include <libkern/section_keywords.h>
@@ -192,10 +193,14 @@ early_random(void)
 	static int init = 0;
 
 	if (init == 0) {
+		boot_progress_stage("bootseed_init enter");
 		bootseed_init();
+		boot_progress_stage("bootseed_init returned");
 
 		/* Init DRBG for NIST HMAC */
+		boot_progress_stage("ccdrbg_factory enter");
 		ccdrbg_factory_nisthmac(&erandom.drbg_info, &erandom.drbg_custom);
+		boot_progress_stage("ccdrbg_factory returned");
 		assert(erandom.drbg_info.size <= sizeof(erandom.drbg_state));
 
 		/*
@@ -204,7 +209,10 @@ early_random(void)
 		 */
 		assert(sizeof(bootseed) > sizeof(nonce));
 		nonce = ml_get_timebase();
+		boot_progress_stage("ml_get_timebase done");
+		boot_progress_stage("ccdrbg_init enter");
 		rc = ccdrbg_init(&erandom.drbg_info, (struct ccdrbg_state *)erandom.drbg_state, sizeof(bootseed), bootseed, sizeof(nonce), &nonce, sizeof(ps) - 1, ps);
+		boot_progress_stage("ccdrbg_init returned");
 		if (rc != CCDRBG_STATUS_OK) {
 			panic("ccdrbg_init() returned %d", rc);
 		}
